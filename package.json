{
  "name": "cajafresh-pos",
  "version": "1.1.0",
  "description": "Caja Fresh POS System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "package": "electron-packager . \"Caja Fresh POS\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=node_modules"
  },
  "build": {
    "appId": "com.zonafresh.cajafreshpos",
    "productName": "Caja Fresh POS",
    "win": {
      "target": "dir",
      "icon": "icon.ico"
    }
  },
  "author": "Zona Fresh",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "^19.0.5",
    "asar": "^3.2.0",
    "electron": "32.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "cloudflared": "^0.7.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "whatsapp-web.js": "^1.34.6"
  }
}
