{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/conectar", "destination": "/conectar.html" },
    { "source": "/descargar", "destination": "/descargar.html" },
    { "source": "/boss/(.*)", "destination": "/boss/$1" },
    { "source": "/jefe/(.*)", "destination": "/jefe/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
